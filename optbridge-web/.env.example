# Deploy google-apps-script/Code.gs as a Google Apps Script Web App, then paste
# its /exec deployment URL here. Vite variables are public, so this is not a secret.
VITE_FORM_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec

# Set to true only if the public launch should include the sample student tracker.
VITE_ENABLE_PORTAL_DEMO=true
