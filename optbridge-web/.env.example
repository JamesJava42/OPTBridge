# Create two forms that notify optbridgesupport@gmail.com, then add their endpoints here.
# Formspree endpoints look like: https://formspree.io/f/your-form-id
VITE_CONTACT_ENDPOINT=https://formspree.io/f/REPLACE_WITH_CONTACT_FORM_ID
VITE_INTAKE_ENDPOINT=https://formspree.io/f/REPLACE_WITH_INTAKE_FORM_ID

# Set to true only if the public launch should include the sample student tracker.
VITE_ENABLE_PORTAL_DEMO=true
